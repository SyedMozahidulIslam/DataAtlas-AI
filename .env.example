# Copy these values into your shell before running the application.
# DATAATLAS_HOME defaults to ./var beside the project.
DATAATLAS_HOME=./var
DATAATLAS_HOST=127.0.0.1
DATAATLAS_PORT=8000
# Used to seed the demo account on first database initialization only.
# Existing demo password hashes are not changed by subsequent starts.
DATAATLAS_DEMO_PASSWORD=dataatlas-demo
